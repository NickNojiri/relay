# Copy to .env and fill in. Never commit .env.

# --- Postgres (owned by packages/db via Drizzle) ---
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Redis (flag cache, sync-server presence/persistence) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js (packages/core) ---
AUTH_SECRET=dev-only-change-me

# --- LLM providers (services/prompt-ops gateway) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Default provider/model the gateway uses when a prompt version doesn't pin one
RELAY_DEFAULT_PROVIDER=ollama
RELAY_DEFAULT_MODEL=llama3.2

# --- Gateway hardening (both optional; empty/0 = off for local dev) ---
# Comma-separated keys; when set, /v1/* requires Authorization: Bearer <key> or x-api-key
RELAY_API_KEYS=
# Max /v1 requests per minute per API key (per client IP when auth is off), per instance
RELAY_RATE_LIMIT_PER_MINUTE=0
# Key the studio's server-side proxy presents to the gateway (one of RELAY_API_KEYS)
PROMPT_OPS_API_KEY=

# --- ports ---
PROMPT_OPS_PORT=8000
SYNC_SERVER_PORT=1234

# --- Observability (opt-in; uv sync --group otel) ---
RELAY_OTEL_ENABLED=false
# Standard OTLP exporter target, e.g. http://localhost:4318 (Jaeger/Tempo/Honeycomb)
OTEL_EXPORTER_OTLP_ENDPOINT=
