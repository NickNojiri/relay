# Copy to .env and fill in. Never commit .env.

# --- Postgres (owned by packages/db via Drizzle) ---
DATABASE_URL=postgres://relay:relay@localhost:5432/relay

# --- Redis (flag cache, sync-server presence/persistence) ---
REDIS_URL=redis://localhost:6379

# --- Auth.js (packages/core) ---
AUTH_SECRET=dev-only-change-me

# --- LLM providers (services/prompt-ops gateway) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Default provider/model the gateway uses when a prompt version doesn't pin one
RELAY_DEFAULT_PROVIDER=ollama
RELAY_DEFAULT_MODEL=llama3.2

# --- ports ---
PROMPT_OPS_PORT=8000
SYNC_SERVER_PORT=1234
