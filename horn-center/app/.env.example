# Copy to .env.local and edit. All VITE_* values are compiled into the bundle and
# are public — a client id and a tenant id are not secrets. Never put a client
# SECRET here; the SPA auth flow (PKCE) does not use one.

# mock (default) = localStorage, no sign-in. dataverse = live org.
VITE_DATA_SOURCE=mock

# Required when VITE_DATA_SOURCE=dataverse
# VITE_DATAVERSE_URL=https://orgXXXXX.crm.dynamics.com

# Required for the standalone MSAL path (not needed inside a Power Apps Code App)
# VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
